NODE_ENV=production

# PostgreSQL
POSTGRES_PASSWORD=troque_esta_senha
DATABASE_URL=postgresql://epasesc:troque_esta_senha@postgres:5432/epasesc

# Autenticação (gere um valor aleatório forte, ex: openssl rand -hex 32)
JWT_SECRET=troque_este_segredo_por_um_valor_aleatorio_longo

# Origem(ns) extra permitida(s) para CORS/cookies, separadas por vírgula
# (ex.: um domínio de produção). NÃO é necessário listar o IP da sua rede
# local aqui — qualquer origem em faixa de IP privada (10.x, 172.16-31.x,
# 192.168.x) ou localhost já é aceita automaticamente, para permitir acesso
# de celulares, notebooks e outros computadores da mesma rede.
APP_ORIGIN=

# Armazenamento de arquivos (MinIO/S3)
# S3_ENDPOINT: endereço interno usado pela API dentro da rede Docker.
S3_ENDPOINT=http://minio:9000
# S3_PUBLIC_PORT: porta do MinIO exposta ao host (ver docker-compose.yml).
# A URL pública de upload/download é montada automaticamente usando o MESMO
# endereço que o navegador usou para abrir o site (localhost, o IP da sua
# rede local, ou um domínio em produção) + esta porta — então funciona em
# qualquer dispositivo da rede sem configuração extra por máquina.
S3_PUBLIC_PORT=9000
S3_REGION=us-east-1
S3_BUCKET=epasesc-private
S3_ACCESS_KEY=troque_este_usuario
S3_SECRET_KEY=troque_esta_senha_min_8_chars

LOG_LEVEL=info

# Backup automático (opcional)
# Caminho no disco do computador onde os backups serão salvos — pode ser
# qualquer pasta em qualquer disco (ex.: D:\Backups\EPasesc no Windows, ou
# /mnt/backup-disk no Linux). Se não for definido, os backups ficam dentro
# da própria pasta do projeto, em ./backup — prefira sempre um disco
# separado do computador que roda os containers.
BACKUP_HOST_PATH=./backup
